<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- ══════════════════════════════════════════════════════════════════
             TEXT SIZE
             ══════════════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Text Size"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="8dp" />

        <!-- Single-select chip group — Small / Normal / Large / X-Large -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true"
            android:layout_marginBottom="4dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFontSmall"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFontNormal"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Normal"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFontLarge"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Large" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFontXLarge"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X-Large" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Live preview sentence -->
        <com.google.android.material.card.MaterialCardView
            style="@style/CardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preview"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvFontPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your expense today is \u20B91,250"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="20dp" />

        <!-- ══════════════════════════════════════════════════════════════════
             APP THEME
             ══════════════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Theme"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <!-- Light -->
            <LinearLayout
                android:id="@+id/cardThemeLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/themePreviewLight"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="#1976D2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">
                        <View android:layout_width="32dp" android:layout_height="6dp"
                            android:background="#1976D2" android:layout_marginBottom="4dp"/>
                        <View android:layout_width="24dp" android:layout_height="4dp"
                            android:background="#BDBDBD" android:layout_marginBottom="3dp"/>
                        <View android:layout_width="24dp" android:layout_height="4dp"
                            android:background="#BDBDBD"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvThemeLightLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Light"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Dark -->
            <LinearLayout
                android:id="@+id/cardThemeDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/themePreviewDark"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardBackgroundColor="#1C1C1E"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:strokeColor="#1976D2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">
                        <View android:layout_width="32dp" android:layout_height="6dp"
                            android:background="#90CAF9" android:layout_marginBottom="4dp"/>
                        <View android:layout_width="24dp" android:layout_height="4dp"
                            android:background="#555555" android:layout_marginBottom="3dp"/>
                        <View android:layout_width="24dp" android:layout_height="4dp"
                            android:background="#555555"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvThemeDarkLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dark"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- AMOLED -->
            <LinearLayout
                android:id="@+id/cardThemeAmoled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/themePreviewAmoled"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardBackgroundColor="#000000"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp"
                    app:strokeColor="#1976D2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:gravity="center">
                        <View android:layout_width="32dp" android:layout_height="6dp"
                            android:background="#FFFFFF" android:layout_marginBottom="4dp"/>
                        <View android:layout_width="24dp" android:layout_height="4dp"
                            android:background="#333333" android:layout_marginBottom="3dp"/>
                        <View android:layout_width="24dp" android:layout_height="4dp"
                            android:background="#333333"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvThemeAmoledLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AMOLED"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="20dp" />

        <!-- ══════════════════════════════════════════════════════════════════
             COLOR PALETTE
             ══════════════════════════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Color Palette"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="12dp" />

        <!-- 5 color circles in a row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <!-- Blue -->
            <LinearLayout
                android:id="@+id/palBlue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/ivPalBlue"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_palette_blue"
                    android:contentDescription="Blue palette" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blue"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Green -->
            <LinearLayout
                android:id="@+id/palGreen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/ivPalGreen"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_palette_green"
                    android:contentDescription="Green palette" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Green"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Purple -->
            <LinearLayout
                android:id="@+id/palPurple"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/ivPalPurple"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_palette_purple"
                    android:contentDescription="Purple palette" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purple"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Orange -->
            <LinearLayout
                android:id="@+id/palOrange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/ivPalOrange"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_palette_orange"
                    android:contentDescription="Orange palette" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Orange"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <!-- Red -->
            <LinearLayout
                android:id="@+id/palRed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/ivPalRed"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/circle_palette_red"
                    android:contentDescription="Red palette" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

        </LinearLayout>

        <!-- Apply button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplySettings"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apply &amp; Restart"
            app:cornerRadius="28dp" />

    </LinearLayout>

</ScrollView>
