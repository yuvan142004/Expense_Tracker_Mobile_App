<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboard_step2_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add your bank accounts so we can track SMS alerts."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp" />

        <!-- ── Bank Spinner ──────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Bank"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerBank"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- ── GREEN badge: reliable bank ──────────────────────────────── -->
        <TextView
            android:id="@+id/tvSmsReliable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅  SMS Reliable — This bank sends alerts for all debit amounts."
            android:textSize="12sp"
            android:textColor="#1B5E20"
            android:background="#E8F5E9"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- ── ORANGE warning: restricted bank ─────────────────────────── -->
        <TextView
            android:id="@+id/tvSmsWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#E65100"
            android:background="#FFF3E0"
            android:padding="10dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- ── Last 4 digits ─────────────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Account last 4 digits"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLast4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── SMS Sender ID ─────────────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSenderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SMS Sender ID (auto-filled — editable)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="4dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSenderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Bank-specific helper note -->
        <TextView
            android:id="@+id/tvSenderNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- Suggestion chips label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick select sender ID:"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <!-- Suggestion chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="false" />

        <!-- Static tooltip -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Sender ID may vary by transaction type (UPI, card, NEFT). You can always edit it manually."
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:background="@drawable/spinner_border"
            android:padding="10dp"
            android:layout_marginBottom="20dp" />

        <!-- Add account -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddAccount"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_add_account"
            android:layout_marginBottom="20dp" />

        <!-- Added accounts list -->
        <TextView
            android:id="@+id/tvNoAccounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No accounts added yet."
            android:textColor="@color/text_hint"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/accountsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- Next -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_next" />

    </LinearLayout>
</ScrollView>
